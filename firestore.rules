rules_version = '2';

// Resekartan: ett enda dokument med familjens data.
// Bara inloggade konton som står i listan kommer åt det.
service cloud.firestore {
  match /databases/{database}/documents {

    // Familjens konton (Firebase-konsolen → Authentication → Users).
    // Lägg till fler uid i listan om någon ska få ett eget konto.
    function familjen() {
      return [
        'NIek1TuzPkam53vMTkh4h8LbQjP2'
      ];
    }

    match /resekartan/data {
      allow read, write: if request.auth != null
                         && request.auth.uid in familjen();
    }

    // Allt annat är stängt
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
