rules_version = '2';

// Resekartan: ett enda dokument med familjens data.
// Bara inloggade konton som står i listan kommer åt det.
service cloud.firestore {
  match /databases/{database}/documents {

    // Familjens konton (Firebase-konsolen → Authentication → Users).
    // Lägg till fler uid i listan om någon ska få ett eget konto.
    //
    // Här ska också avsändaren av årsdagsnotiser stå. Den loggar in som en
    // vanlig användare i stället för att använda en tjänstekontonyckel – dels
    // för att organisationen förbjuder såna nycklar, dels för att en nyckel går
    // förbi de här reglerna helt. Se docs/arsdagsnotiser.md.
    function familjen() {
      return [
        'NIek1TuzPkam53vMTkh4h8LbQjP2',
	'gryX85RCD7YH2e8v9js7Va18phj2'
      ];
    }

    // Täcker både resekartan/data och bilderna i resekartan/data/foton
    match /resekartan/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid in familjen();
    }

    // Allt annat är stängt
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
